{
  "name": "@inspect-hub/database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.build.json",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.14.0",
    "typescript": "5.9.2"
  }
}
