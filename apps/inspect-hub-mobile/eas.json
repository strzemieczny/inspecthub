{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://bw-mind-dev.borgwarner.net/inspect-hub/api",
        "MOBILE_ALLOW_HTTP": "1"
      }
    },
    "production": {
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://bw-mind-dev.borgwarner.net/inspect-hub/api",
        "MOBILE_ALLOW_HTTP": "1"
      }
    }
  }
}
