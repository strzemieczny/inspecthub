generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum ScadaDeliveryStatus {
  PENDING
  RETRYING
  DELIVERED
  FAILED
}

enum EventSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum EventOutcome {
  SUCCESS
  FAILURE
  UNKNOWN
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String?
  externalProvider  String?
  externalId        String?
  role              Role               @default(OPERATOR)
  name              String
  createdAt         DateTime           @default(now())
  inspectionResults InspectionResult[] @relation("OperatorInspections")
  auditEvents       AuditEvent[]       @relation("AuditEventActor")

  @@unique([externalProvider, externalId])
}

/// Append-only operational and audit trail. Application code exposes no update/delete API.
model AuditEvent {
  id            String        @id @default(uuid())
  occurredAt    DateTime
  receivedAt    DateTime      @default(now())
  type          String
  category      String
  severity      EventSeverity @default(INFO)
  outcome       EventOutcome  @default(UNKNOWN)
  source        String
  schemaVersion Int           @default(1)
  correlationId String
  actorId       String?
  actorType     String?
  stationCode   String?
  entityType    String?
  entityId      String?
  payload       Json
  payloadHash   String
  actor         User?         @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([receivedAt])
  @@index([type, occurredAt])
  @@index([correlationId])
  @@index([stationCode, occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
}

model AccessCardMapping {
  id              String   @id @default(cuid())
  uidHash         String   @unique
  apacsCardNumber Int      @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Form {
  id                 String             @id @default(cuid())
  title              String
  code               String
  version            Int                @default(1)
  nokStreakThreshold Int                @default(3)
  requiresLogin      Boolean            @default(false)
  allowedStatuses    Json
  questions          Json
  archivedAt         DateTime?
  processes          Process[]          @relation("FormProcesses")
  createdAt          DateTime           @default(now())
  inspectionResults  InspectionResult[]

  @@unique([code, version])
  @@index([code])
  @@index([archivedAt])
}

model Process {
  id       String    @id @default(cuid())
  name     String    @unique
  stations Station[]
  forms    Form[]    @relation("FormProcesses")
}

model Station {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  ipAddress       String?  @unique
  deviceTokenHash String?  @unique
  processId       String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  process         Process? @relation(fields: [processId], references: [id])

  @@index([active])
  @@index([processId])
}

model InspectionResult {
  id                   String             @id @default(cuid())
  publicReportId       String             @unique
  clientSubmissionId   String?            @unique
  formId               String
  vinOrSerialNumber    String
  stationId            String
  operatorId           String?
  status               String
  answers              Json
  durationSeconds      Int?
  answerCorrections    Int                @default(0)
  mesSynced            Boolean            @default(false)
  partNumber           String?
  productFamily        String?
  scadaServerUrl       String?
  routeCheckId         String?            @unique
  originalInspectionId String?
  scadaDelivery        ScadaDelivery?
  routeCheck           RouteCheck?        @relation(fields: [routeCheckId], references: [id])
  originalInspection   InspectionResult?  @relation("InspectionRetests", fields: [originalInspectionId], references: [id], onDelete: SetNull)
  retests              InspectionResult[] @relation("InspectionRetests")
  createdAt            DateTime           @default(now())
  form                 Form               @relation(fields: [formId], references: [id])
  operator             User?              @relation("OperatorInspections", fields: [operatorId], references: [id])

  @@index([formId])
  @@index([operatorId])
  @@index([vinOrSerialNumber])
  @@index([originalInspectionId])
  @@index([mesSynced])
}

model ScadaSettings {
  id               String   @id
  enabled          Boolean  @default(false)
  baseUrl          String   @default("")
  routeCheckPath   String   @default("/api/route-check")
  submitResultPath String   @default("/api/inspection-result")
  publicWebUrl     String   @default("http://localhost:5173")
  timeoutMs        Int      @default(5000)
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

model RouteCheck {
  id               String            @id @default(cuid())
  serialNumber     String
  stationCode      String
  processName      String
  allowed          Boolean
  partNumber       String?
  productFamily    String?
  serverUrl        String?
  checkedAt        DateTime          @default(now())
  inspectionResult InspectionResult?

  @@index([serialNumber])
  @@index([checkedAt])
}

model ScadaDelivery {
  id                 String              @id @default(cuid())
  inspectionResultId String              @unique
  payload            Json
  status             ScadaDeliveryStatus @default(PENDING)
  attemptCount       Int                 @default(0)
  nextAttemptAt      DateTime            @default(now())
  lastError          String?
  deliveredAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inspectionResult   InspectionResult    @relation(fields: [inspectionResultId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}
