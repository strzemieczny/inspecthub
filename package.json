{
  "name": "inspect-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "mobile:start": "pnpm --filter inspect-hub-mobile start",
    "mobile:android": "pnpm --filter inspect-hub-mobile android",
    "mobile:build:apk": "pnpm --filter inspect-hub-mobile build:apk"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13"
  }
}
