{
  "name": "inspect-hub-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist",
    "build:apk": "eas build --platform android --profile production",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "^15.1.1",
    "@inspect-hub/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-circle-flags": "^0.1.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "type": "module"
}
