# Template only: replace all example credentials on the server.
# Copy to .env.production; never commit the populated file.
IH_ENV_FILE=.env.production.example
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:RELEASE.2024-01-28T22-35-53Z
POSTGRES_USER=inspect_user
POSTGRES_PASSWORD=example-only-replace-before-deploy
POSTGRES_DB=inspect_hub_db
DATABASE_URL=postgresql://inspect_user:example-only-replace-before-deploy@postgres:5432/inspect_hub_db?schema=public
JWT_SECRET=example-only-replace-with-random-secret-at-least-32-characters
WEB_ORIGIN=https://bw-mind-dev.borgwarner.net
STATION_COOKIE_SECURE=true
PUBLIC_API_URL=https://bw-mind-dev.borgwarner.net/inspect-hub/api
MINIO_ROOT_USER=inspect_storage
MINIO_ROOT_PASSWORD=example-only-replace-with-random-storage-secret
# Optional APACS credentials belong here, using the APACS_DB_* keys in .env.example.

# Active Directory: ten sam mechanizm service bind / search / user bind co w BW-Mind.
LDAP_URL=ldaps://ad.example.local:636
LDAP_BIND_DN=CN=InspectHubReader,OU=ServiceAccounts,DC=example,DC=local
LDAP_BIND_PASSWORD=replace-me
LDAP_SEARCH_BASE=DC=example,DC=local
# Nazwa CN lub pełny DN grupy; administratorzy nie muszą należeć do grupy operatorów.
LDAP_ADMIN_GROUP=Inspect-Hub-Admins
LDAP_REQUIRED_GROUP=Inspect-Hub-Operators
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_REQUEST_TIMEOUT_MS=10000
# Dla firmowego CA ustaw NODE_EXTRA_CA_CERTS na ścieżkę do pliku PEM dostępną w kontenerze API.
